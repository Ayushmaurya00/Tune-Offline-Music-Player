{
  "name": "tune",
  "version": "1.0.0",
  "type": "module",
  "description": "Tune - Modern Offline Music Player",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "dev:electron": "npm run build && electron .",
    "dev:web": "vite --mode web --host",
    "dev:mobile": "vite --mode web --host",
    "build": "tsc && vite build",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir",
    "build:mobile": "tsc && vite build && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "preview": "vite preview"
  },
  "keywords": [
    "music",
    "player",
    "offline",
    "electron",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "discord-rpc": "^4.0.1",
    "howler": "^2.2.4",
    "lucide-react": "^1.16.0",
    "music-metadata": "^10.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@types/discord-rpc": "^4.0.11",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
